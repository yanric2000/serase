{
  "name": "api",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "api/src",
  "tags": ["type:app", "scope:api"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mvnw.cmd spring-boot:run",
        "cwd": "api"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mvnw.cmd test",
        "cwd": "api"
      }
    }
  }
}
